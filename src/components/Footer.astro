---
// Pie a todo el ancho en océano hondo: cuatro columnas (marca y redes, menú, contacto, horario) y, debajo, el
// nombre del negocio en mayúsculas gigantes de contorno, como el rótulo de un muelle. Todo sale de site.yaml.
// «Web creada con NoExpertise» se muestra si site.yaml → marca_pie no es false.
import { site, tel, whatsapp, mapa } from '../data/site';
import Icono from './ui/Icono.astro';
interface Props { variante?: string }
const { variante = 'viajes' } = Astro.props;
const c = site.contacto;
const redes = Object.entries(site.redes).filter(([, url]) => url);
const anio = new Date().getFullYear();
const horarios = Object.values(site.secciones).find((s) => s.activa && s.horario.length > 0)?.horario ?? [];
---

<footer class={`pie pie--${variante}`}>
  <div class="contenedor">
    <div class="pie-rejilla">
      <div>
        <p class="din flex items-center gap-3 text-[1.6rem] font-bold uppercase leading-none tracking-wide">
          <span class="grid size-10 shrink-0 place-items-center rounded-full bg-acento text-texto" aria-hidden="true"><Icono nombre="brujula" tam={22} /></span>
          {site.nombre}
        </p>
        {site.eslogan && <p class="pie-eslogan mt-4">{site.eslogan}</p>}
        {
          redes.length > 0 && (
            <ul class="pie-redes">
              {redes.map(([red, url]) => (
                <li>
                  <a href={url} rel="noopener" target="_blank" aria-label={red}>
                    <Icono nombre={red} tam={18} />
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
      {
        site.menu.length > 0 && (
          <nav aria-label="Menú del pie">
            <p class="pie-titulo">La web</p>
            <ul class="pie-lista">
              {site.menu.map((e) => <li><a href={e.url}>{e.texto}</a></li>)}
            </ul>
          </nav>
        )
      }
      {
        (c.telefono || c.whatsapp || c.email || c.direccion) && (
          <div>
            <p class="pie-titulo">Contacto</p>
            <ul class="pie-lista">
              {c.telefono && <li><a href={tel(c.telefono)}><span class="sr-only">Teléfono: </span>{c.telefono}</a></li>}
              {c.whatsapp && <li><a href={whatsapp(c.whatsapp)} rel="noopener" target="_blank">WhatsApp {c.whatsapp}</a></li>}
              {c.email && <li><a class="break-all" href={`mailto:${c.email}`}>{c.email}</a></li>}
              {c.direccion && <li><a href={mapa(c.direccion)} rel="noopener" target="_blank">{c.direccion}</a></li>}
            </ul>
          </div>
        )
      }
      {
        (horarios.length > 0 || c.horario) && (
          <div>
            <p class="pie-titulo">Horario</p>
            {horarios.length > 0 ? (
              <ul class="pie-lista">
                {horarios.map((h) => (
                  <li><span class="block font-semibold">{h.dia}</span><span class="pie-eslogan">{h.horas}</span></li>
                ))}
              </ul>
            ) : (
              <p class="pie-eslogan">{c.horario}</p>
            )}
          </div>
        )
      }
    </div>
  </div>
  <p class="pie-gigante mt-14 px-4 md:mt-20" aria-hidden="true">{site.nombre}</p>
  <div class="contenedor pie-legal">
    <span>© {anio} {site.nombre}</span>
    <a href="/aviso-legal">Aviso legal y privacidad</a>
    {
      site.marca_pie && (
        <span class="pie-noexpertise">
          Web creada con <a href="https://noexpertise.com" rel="noopener">NoExpertise</a>
        </span>
      )
    }
  </div>
</footer>
