---
// Proceso: `items: [{titulo, texto, icono}]` como paradas de una ruta punteada: en vertical en móvil y en
// horizontal (una columna por paso) desde 900 px, con número grande en naranja e icono en círculo océano.
// Sin pasos solo queda el titular (o nada si tampoco hay título). `cta` opcional al final.
import { seccion, enlace } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const { id } = Astro.props;
const s = seccion(id);
const n = s?.items.length ?? 0;
const cta = enlace(s?.cta);
const dos = (i: number) => String(i + 1).padStart(2, '0');
---

{
  s && (n > 0 || s.titulo) && (
    <Seccion id={id} banda="arena2">
      <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
      {n > 0 && (
        <ol class="ruta" style={`--n:${Math.min(n, 6)}`}>
          {s.items.map((it, i) => (
            <li>
              <span class="ruta-parada" aria-hidden="true"><Icono nombre={it.icono || 'mapa'} tam={22} /></span>
              <p class="ruta-num" aria-hidden="true">{dos(i)}</p>
              <h3 class="mt-3 text-[1.75rem]">{it.titulo}</h3>
              {it.texto && <p class="suave mt-2 max-w-[24rem]">{it.texto}</p>}
            </li>
          ))}
        </ol>
      )}
      {cta && <p class="mt-14"><a class="btn" href={cta.url}>{cta.texto}</a></p>}
    </Seccion>
  )
}
