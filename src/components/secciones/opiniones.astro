---
// Opiniones: banda océano. La primera de `testimonios: [{texto, autor, nota}]` va como cita enorme a todo el
// ancho con comillas naranjas; el resto, en 3 columnas con una línea naranja arriba.
// Sin testimonios no se pinta (la plataforma nunca inventa opiniones).
import { seccion, cadena } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const { id } = Astro.props;
const s = seccion(id);
const lista = (s?.testimonios ?? []).filter((t) => cadena(t.texto));
const [primera, ...resto] = lista;
const columnas = resto.length >= 3 ? 'md:grid-cols-3' : resto.length === 2 ? 'md:grid-cols-2' : '';
---

{
  s && primera && (
    <Seccion id={id} banda="oceano">
      <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
      <figure class="grid gap-6 lg:grid-cols-[8rem_minmax(0,1fr)] lg:gap-10">
        <span class="comillas" aria-hidden="true">&ldquo;</span>
        <div>
          <blockquote class="cita-grande max-w-[60rem]">{primera.texto}</blockquote>
          <figcaption class="mt-7 flex flex-wrap items-baseline gap-x-4 gap-y-1">
            <span class="rotulo text-[color:var(--sol-claro)]">{primera.autor}</span>
            {cadena(primera.nota) && <span class="suave text-sm">{primera.nota}</span>}
          </figcaption>
        </div>
      </figure>
      {resto.length > 0 && (
        <ul class:list={['mt-16 grid gap-10 md:mt-24 lg:gap-14', columnas]}>
          {resto.map((t) => (
            <li class="opinion">
              <figure>
                <blockquote class="text-lg leading-relaxed">«{t.texto}»</blockquote>
                <figcaption class="mt-5">
                  <span class="rotulo block text-[color:var(--sol-claro)]">{t.autor}</span>
                  {cadena(t.nota) && <span class="suave mt-1 block text-sm">{t.nota}</span>}
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      )}
    </Seccion>
  )
}
