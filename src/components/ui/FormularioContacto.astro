---
// Formulario sin servidor: si hay email en site.yaml abre el programa de correo (mailto) con todos los campos en el
// cuerpo. Si no hay email, se queda como muestra y lo avisa.
// `viaje`: añade destino, fechas de ida y vuelta, adultos y niños (presupuesto). `tipos`: opciones del desplegable
// «Tipo de viaje» (de secciones.presupuesto.tipos_viaje). `prefijo`: para que dos formularios no repitan ids.
// Para un envío real, cambia `action` por el de tu proveedor.
import { site } from '../../data/site';
interface Props { boton?: string; class?: string; asunto?: string; tipos?: string[]; viaje?: boolean; prefijo?: string }
const { boton = 'Enviar', class: clase = '', asunto = `Consulta desde la web de ${site.nombre}`, tipos = [], viaje = false, prefijo = 'f' } = Astro.props;
const email = site.contacto.email;
const accion = email ? `mailto:${email}?subject=${encodeURIComponent(asunto)}` : '';
const id = (n: string) => `${prefijo}-${n}`;
---

<form class:list={['formulario', clase]} action={accion || undefined} method="post" enctype="text/plain">
  <div class="grid gap-4 sm:grid-cols-2">
    <div class="campo">
      <label for={id('nombre')}>Nombre</label>
      <input id={id('nombre')} name="nombre" type="text" autocomplete="name" required />
    </div>
    <div class="campo">
      <label for={id('contacto')}>Email o teléfono</label>
      <input id={id('contacto')} name="contacto" type="text" autocomplete="email" required />
    </div>
    {
      viaje && (
        <>
          <div class="campo">
            <label for={id('destino')}>Destino</label>
            <input id={id('destino')} name="destino" type="text" placeholder="Donde te apetezca" />
          </div>
          {tipos.length > 0 ? (
            <div class="campo">
              <label for={id('tipo')}>Tipo de viaje</label>
              <select id={id('tipo')} name="tipo">
                {tipos.map((t) => <option value={t}>{t}</option>)}
              </select>
            </div>
          ) : <div class="hidden sm:block" />}
          <div class="campo">
            <label for={id('ida')}>Fecha de ida</label>
            <input id={id('ida')} name="ida" type="date" />
          </div>
          <div class="campo">
            <label for={id('vuelta')}>Fecha de vuelta</label>
            <input id={id('vuelta')} name="vuelta" type="date" />
          </div>
          <div class="campo">
            <label for={id('adultos')}>Adultos</label>
            <input id={id('adultos')} name="adultos" type="number" min="1" max="99" inputmode="numeric" value="2" />
          </div>
          <div class="campo">
            <label for={id('ninos')}>Niños</label>
            <input id={id('ninos')} name="ninos" type="number" min="0" max="99" inputmode="numeric" value="0" />
          </div>
        </>
      )
    }
  </div>
  <div class="campo">
    <label for={id('mensaje')}>Mensaje</label>
    <textarea id={id('mensaje')} name="mensaje" rows="4" required></textarea>
  </div>
  <label class="campo-check">
    <input type="checkbox" name="privacidad" required />
    <span>He leído el <a href="/aviso-legal">aviso legal y la política de privacidad</a>.</span>
  </label>
  <button type="submit" class="btn">{boton}</button>
  <p class="formulario-aviso">
    {
      email
        ? 'Al enviar se abre tu programa de correo con el mensaje listo.'
        : 'Formulario de muestra: todavía no envía mensajes. Usa el teléfono o el email de contacto.'
    }
  </p>
</form>
