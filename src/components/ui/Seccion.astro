---
// Envoltorio de sección: una banda a todo el ancho de la ventana (`banda`: arena, arena2, papel, oceano, hondo
// o sol) con el contenido dentro de un ancho generoso (90 rem) y 16 px de margen lateral en móvil.
// Con `sinContenedor` la banda no lleva ritmo ni contenedor (para filas foto/texto a sangre).
// Adaptado de AstroWind (WidgetWrapper.astro), © onWidget, licencia MIT (LICENSE-ASTROWIND.md).
interface Props { id?: string; class?: string; contenedor?: string; banda?: string; etiqueta?: string; sinContenedor?: boolean }
const { id, class: clase = '', contenedor = '', banda = 'arena', etiqueta, sinContenedor = false } = Astro.props;
---

<section class:list={['banda', `banda--${banda}`, !sinContenedor && 'seccion', clase]} id={id} aria-label={etiqueta}>
  {sinContenedor ? <slot /> : <div class:list={['contenedor', contenedor]}><slot /></div>}
</section>
