---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada">
  <section class="banda banda--hondo hero-sin-foto relative isolate overflow-hidden">
    <div class="contenedor relative py-24 md:py-40">
      <p class="antetitulo">Error 404 · Destino desconocido</p>
      <h1 class="titulo-hero mt-5 max-w-[14ch]">Esta página no existe</h1>
      <p class="suave mt-6 max-w-[34rem] text-lg">Puede que el enlace esté mal o que la página haya cambiado de ruta.</p>
      <p class="mt-10"><a class="btn" href="/">Volver al inicio</a></p>
    </div>
  </section>
</Base>
