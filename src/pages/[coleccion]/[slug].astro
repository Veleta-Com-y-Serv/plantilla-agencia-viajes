---
// Ficha de un viaje con `detalle` (src/lib/paginas.ts, listas de src/data/fichas.ts): /viajes/<slug>/.
// Diseño «billete de embarque»: banda océano hondo con migas y hero partido (destino en rótulo, título en
// mayúsculas estrechas, texto, botones; a la derecha la foto o, sin foto, un avión grande sobre fondo punteado);
// banda arena con el `detalle` y, al lado, un billete con talón troquelado (precio, datos y botón); franja de
// fotos (`imagenes`) en océano; y otros viajes de la misma lista como billetes en banda arena tostada.
import Base from '../../layouts/Base.astro';
import Imagen from '../../components/ui/Imagen.astro';
import Icono from '../../components/ui/Icono.astro';
import Titular from '../../components/ui/Titular.astro';
import { seccion, site, tel, whatsapp } from '../../data/site';
import { fichas, relacionadas, resumen } from '../../lib/paginas';
import type { Ficha } from '../../lib/paginas';
import { altGaleria, jsonLdFicha, jsonLdMigas, urlBase } from '../../lib/seo';
import { enlace, rutaDeSeccion } from '../../lib/multipagina';

export function getStaticPaths() {
  return fichas().map((f) => ({ params: { coleccion: f.def.ruta, slug: f.slug }, props: { f } }));
}

interface Props { f: Ficha }
const { f } = Astro.props;
const base = urlBase(Astro.site);
const nombreSeccion = String(f.seccion.antetitulo || f.seccion.titulo || f.def.nombre).trim();
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: nombreSeccion, ruta: rutaDeSeccion(f.idSeccion) },
  { nombre: f.titulo, ruta: f.url },
];
const c = site.contacto;
const presupuesto = seccion('presupuesto') ? enlace('/#presupuesto') : site.boton_cabecera?.url || enlace('/#contacto');
const wa = whatsapp(c.whatsapp, `Hola, quiero información sobre ${f.titulo}`);
const destino = f.datos.find((d) => d.clave === 'destino')?.valor ?? '';
const datos = f.datos.filter((d) => d.clave !== 'precio' && d.clave !== 'destino');
const otras = relacionadas(f, 3);
const descripcion = resumen(f.texto || f.detalle[0] || '');
---

<Base titulo={f.titulo} descripcion={descripcion} imagen={f.imagen} ld={[jsonLdMigas(base, migas), jsonLdFicha(base, f)]}>
  <section class="banda banda--hondo ficha-cabeza">
    <div class="contenedor">
      <nav aria-label="Migas de pan" class="migas">
        <ol>
          {migas.map((m, i) => (
            <li>{i < migas.length - 1 ? <a href={m.ruta}>{m.nombre}</a> : <span aria-current="page">{m.nombre}</span>}</li>
          ))}
        </ol>
      </nav>
      <div class="ficha-hero">
        <div class="ficha-hero-texto">
          <p class="antetitulo">{destino || f.categoria || f.def.nombre}</p>
          <h1 class="titulo-seccion">{f.titulo}</h1>
          {f.texto && <p class="titular-texto suave">{f.texto}</p>}
          <div class="ficha-botones">
            <a class="btn" href={presupuesto}>Pide presupuesto</a>
            {wa && <a class="btn-sec" href={wa} target="_blank" rel="noopener"><Icono nombre="whatsapp" tam={18} /> WhatsApp</a>}
          </div>
        </div>
        {f.imagen ? (
          <div class="ficha-foto">
            <Imagen src={f.imagen} alt={f.titulo} ancho={1200} alto={900} prioridad class="h-full w-full object-cover" />
          </div>
        ) : (
          <div class="ficha-icono" aria-hidden="true"><Icono nombre={f.icono || 'avion'} tam={96} /></div>
        )}
      </div>
    </div>
  </section>

  <section class="banda banda--arena ficha-seccion">
    <div class="contenedor ficha-cuerpo">
      <article class="ficha-detalle">
        {f.detalle.map((p) => <p>{p}</p>)}
      </article>
      <aside class="ficha-lado">
        <div class="billete ficha-billete">
          <div class="ficha-billete-arriba">
            <p class="rotulo ficha-billete-rotulo">Tu billete</p>
            {f.precio && <p class="billete-precio">{f.precio}</p>}
          </div>
          {datos.length > 0 && (
            <dl>
              {datos.map((d) => <div><dt>{d.etiqueta}</dt><dd>{d.valor}</dd></div>)}
            </dl>
          )}
          <div class="billete-corte" aria-hidden="true" />
          <div class="ficha-billete-abajo">
            <a class="btn w-full text-center" href={presupuesto}>Pide presupuesto</a>
            {c.telefono && <a class="ficha-tel" href={tel(c.telefono)}><Icono nombre="telefono" tam={18} /> {c.telefono}</a>}
          </div>
        </div>
      </aside>
    </div>
  </section>

  {f.imagenes.length > 0 && (
    <section class="banda banda--oceano ficha-seccion" aria-label={`Fotos de ${f.titulo}`}>
      <div class="contenedor">
        <ul class="ficha-galeria">
          {f.imagenes.map((src, i) => (
            <li><Imagen src={src} alt={`${f.titulo}: ${altGaleria(i).toLowerCase()}`} ancho={800} alto={600} class="h-full w-full object-cover" /></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {otras.length > 0 && (
    <section class="banda banda--arena2 ficha-seccion">
      <div class="contenedor">
        <Titular antetitulo={nombreSeccion} titulo="Otros viajes" forma="izq" />
        <ul class="ficha-otras">
          {otras.map((o) => (
            <li class="billete ficha-otra">
              {o.imagen && (
                <div class="ficha-otra-foto"><Imagen src={o.imagen} alt="" ancho={600} alto={450} class="h-full w-full object-cover" /></div>
              )}
              <div class="ficha-otra-cuerpo">
                <h3><a href={o.url} class="ficha-otra-enlace">{o.titulo}</a></h3>
                {o.texto && <p class="suave">{o.texto}</p>}
                <p class="ficha-otra-pie">
                  {o.precio && <span class="billete-precio">{o.precio}</span>}
                  <span class="ficha-otra-ver rotulo" aria-hidden="true">Ver <Icono nombre="flecha" tam={16} /></span>
                </p>
              </div>
            </li>
          ))}
        </ul>
        <p class="mt-10"><a class="btn-sec" href={rutaDeSeccion(f.idSeccion)}>Ver todos los viajes</a></p>
      </div>
    </section>
  )}
</Base>

<style>
  .ficha-cabeza { padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(3rem, 6vw, 5rem); }
  .ficha-seccion { padding-block: var(--ritmo); }
  @media (min-width: 1024px) { .ficha-seccion { padding-block: 6rem; } }
  .migas ol { display: flex; flex-wrap: wrap; gap: .25rem .5rem; font-family: var(--fuente-titulos); font-size: .8rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; }
  .migas li { display: inline-flex; align-items: center; gap: .5rem; min-width: 0; }
  .migas li + li::before { content: "›"; opacity: .5; }
  .migas a { color: var(--sol-claro); text-decoration: none; min-height: 2.75rem; display: inline-flex; align-items: center; }
  .migas a:hover { text-decoration: underline; }
  .migas [aria-current] { opacity: .75; overflow-wrap: anywhere; }
  .ficha-hero { display: grid; gap: 2.5rem; margin-top: clamp(1rem, 3vw, 2.5rem); align-items: center; }
  .ficha-hero-texto .titulo-seccion { font-size: clamp(2.6rem, 8vw, 6rem); line-height: .9; overflow-wrap: anywhere; }
  .ficha-botones { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .ficha-botones a { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; }
  .ficha-foto { aspect-ratio: 4 / 3; border-radius: .9rem; overflow: hidden; background: var(--oceano); box-shadow: 0 30px 60px rgb(0 0 0 / .35); }
  .ficha-icono { display: grid; place-items: center; aspect-ratio: 4 / 3; border-radius: .9rem; border: 2px dashed color-mix(in srgb, var(--c-fondo) 30%, transparent); color: var(--sol); }
  .ficha-cuerpo { display: grid; gap: 3rem; }
  .ficha-detalle { max-width: 44rem; font-size: 1.12rem; }
  .ficha-detalle p + p { margin-top: 1.2rem; }
  .ficha-detalle p:first-child { font-size: 1.3rem; }
  .ficha-lado { align-content: start; }
  .ficha-billete { --pad: 1.5rem; --banda-fondo: var(--arena); height: auto; border: 2px solid var(--tinta); }
  .ficha-billete-arriba { padding: 1.5rem 1.5rem 1rem; display: flex; align-items: end; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .ficha-billete-rotulo { color: var(--sol-texto); }
  .ficha-billete .billete-precio { font-size: 2.25rem; }
  .ficha-billete dl { padding: 0 1.5rem 1.5rem; }
  .ficha-billete dl > div { display: flex; justify-content: space-between; gap: 1rem; padding: .7rem 0; border-top: 1px solid var(--linea); }
  .ficha-billete dt { font-family: var(--fuente-titulos); font-weight: 600; font-size: .8rem; letter-spacing: .12em; text-transform: uppercase; color: var(--suave); }
  .ficha-billete dd { text-align: right; font-weight: 600; min-width: 0; overflow-wrap: anywhere; }
  .ficha-billete-abajo { display: grid; gap: .5rem; padding: 1.5rem; }
  .ficha-tel { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; min-height: 2.75rem; font-family: var(--fuente-titulos); font-weight: 700; letter-spacing: .08em; color: var(--tinta); text-decoration: none; }
  .ficha-galeria { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }
  .ficha-galeria li { aspect-ratio: 4 / 3; border-radius: var(--radio); overflow: hidden; }
  .ficha-otras { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); }
  .ficha-otra { height: auto; --banda-fondo: var(--arena-2); }
  .ficha-otra-foto { aspect-ratio: 4 / 3; overflow: hidden; background: var(--oceano); }
  .ficha-otra-cuerpo { display: flex; flex: 1; flex-direction: column; gap: .6rem; padding: 1.25rem 1.25rem 1.5rem; }
  .ficha-otra h3 { font-size: 1.7rem; }
  .ficha-otra-enlace { text-decoration: none; color: inherit; }
  .ficha-otra-enlace::after { content: ""; position: absolute; inset: 0; }
  .ficha-otra-enlace:focus-visible { outline: none; }
  .ficha-otra:has(.ficha-otra-enlace:focus-visible) { outline: 3px solid var(--sol); outline-offset: 2px; }
  .ficha-otra-pie { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: auto; padding-top: .5rem; }
  .ficha-otra-ver { display: inline-flex; align-items: center; gap: .3rem; color: var(--sol-texto); }
  @media (min-width: 1024px) {
    .ficha-hero { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 4rem; }
    .ficha-cuerpo { grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 5rem; align-items: start; }
    .ficha-lado { position: sticky; top: 6.5rem; }
  }
</style>
